# Optional: only when using `npm run dev` + a second terminal with `vercel dev -l 3000`.
# Leave unset when using `npm run dev:vercel` alone (same-origin /api, no proxy).
# CONTACT_API_PROXY_TARGET=http://127.0.0.1:3000

# Resend (required for /api/contact in all environments)
# https://resend.com/api-keys
# Copy to `.env.local` (gitignored). `api/contact.js` loads `.env` / `.env.local` so `vercel dev` sees the key.
RESEND_API_KEY=re_xxxxxxxx

# Upstash Redis for distributed rate limiting (5 req/min per IP in production on Vercel)
# https://console.upstash.com/ — create a Redis database and copy REST URL + token
# In local dev, if these are omitted, an in-memory limiter is used (not suitable for multi-instance prod).
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
